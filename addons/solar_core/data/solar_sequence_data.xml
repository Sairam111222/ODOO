<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
    SolarFlow 360 — Sequence Definitions
    Auto-incrementing reference numbers for solar business records.
    -->
    <data noupdate="1">

        <record id="seq_solar_survey" model="ir.sequence">
            <field name="name">Site Survey Sequence</field>
            <field name="code">solar.site.survey</field>
            <field name="prefix">SRV/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_solar_installation" model="ir.sequence">
            <field name="name">Installation Sequence</field>
            <field name="code">solar.installation</field>
            <field name="prefix">INS/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_solar_warranty" model="ir.sequence">
            <field name="name">Warranty Sequence</field>
            <field name="code">solar.warranty</field>
            <field name="prefix">WRN/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_solar_service_ticket" model="ir.sequence">
            <field name="name">Service Ticket Sequence</field>
            <field name="code">solar.service.ticket</field>
            <field name="prefix">SVC/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_solar_package" model="ir.sequence">
            <field name="name">Solar Package Sequence</field>
            <field name="code">solar.package</field>
            <field name="prefix">PKG/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_solar_subsidy" model="ir.sequence">
            <field name="name">Subsidy Dossier Sequence</field>
            <field name="code">solar.subsidy.tracker</field>
            <field name="prefix">SUB/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
