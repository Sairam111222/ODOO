<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Solar Package Tree View -->
    <record id="view_solar_package_tree" model="ir.ui.view">
        <field name="name">solar.package.tree</field>
        <field name="model">solar.package</field>
        <field name="arch" type="xml">
            <tree string="Solar Packages" decoration-success="state == 'active'" decoration-muted="state == 'discontinued'">
                <field name="code"/>
                <field name="name"/>
                <field name="system_type_id"/>
                <field name="capacity_kw"/>
                <field name="base_equipment_price" string="Equipment Cost" widget="monetary"/>
                <field name="installation_charge" string="Labour &amp; Install" widget="monetary"/>
                <field name="total_price" widget="monetary"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-info="state == 'draft'"/>
            </tree>
        </field>
    </record>

    <!-- Solar Package Form View -->
    <record id="view_solar_package_form" model="ir.ui.view">
        <field name="name">solar.package.form</field>
        <field name="model">solar.package</field>
        <field name="arch" type="xml">
            <form string="Solar Package">
                <header>
                    <button name="action_auto_calculate_materials" string="Auto-Calculate BOM &amp; Quantities" type="object" class="btn-info" invisible="state == 'discontinued'"/>
                    <button name="action_activate" string="Activate Package" type="object" class="oe_highlight" invisible="state != 'draft'" groups="solar_core.group_solar_director"/>
                    <button name="action_discontinue" string="Discontinue" type="object" invisible="state != 'active'" groups="solar_core.group_solar_director"/>
                    <button name="action_draft" string="Set to Draft" type="object" invisible="state != 'discontinued'" groups="solar_core.group_solar_director"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,discontinued"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Package Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. 3kW On-Grid Premium Residential"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Package Specifications">
                            <field name="code"/>
                            <field name="system_type_id"/>
                            <field name="capacity_kw"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Commercial Pricing &amp; Breakdown">
                            <field name="base_equipment_price" widget="monetary"/>
                            <field name="installation_charge" widget="monetary"/>
                            <field name="transport_charge" widget="monetary"/>
                            <field name="discom_paperwork_charge" widget="monetary"/>
                            <field name="total_price" class="oe_subtotal_footer_separator" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Major Equipment Sizing" name="major_components">
                            <group>
                                <group string="Solar Panels">
                                    <field name="panel_product_id"/>
                                    <field name="panel_wattage"/>
                                    <field name="panel_quantity"/>
                                    <field name="total_panel_capacity_kw"/>
                                </group>
                                <group string="Inverter &amp; Battery Bank">
                                    <field name="inverter_product_id"/>
                                    <field name="inverter_capacity_kw"/>
                                    <field name="battery_product_id"/>
                                    <field name="battery_capacity_ah"/>
                                    <field name="battery_quantity"/>
                                </group>
                            </group>
                        </page>
                        <page string="Bill of Materials (BOM Breakdown)" name="bom_lines">
                            <field name="package_line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="component_type"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="unit_price" widget="monetary"/>
                                    <field name="subtotal" widget="monetary"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Warranty Terms" name="warranties">
                            <group>
                                <group string="Standard Component Guarantees">
                                    <field name="panel_warranty_years"/>
                                    <field name="inverter_warranty_years"/>
                                    <field name="workmanship_warranty_years"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Action & Menu -->
    <record id="action_solar_package" model="ir.actions.act_window">
        <field name="name">Standard Solar Packages</field>
        <field name="res_model">solar.package</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define your standard 1kW to 5kW solar packages</p>
        </field>
    </record>

    <menuitem id="menu_solar_package_act"
              name="All Packages"
              parent="solar_core.menu_solar_packages"
              action="action_solar_package"
              sequence="10"/>
</odoo>
