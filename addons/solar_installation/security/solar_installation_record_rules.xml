<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Technicians: only see their own assigned installations -->
    <record id="rule_technician_own_installations" model="ir.rule">
        <field name="name">Technician: Own Installations Only</field>
        <field name="model_id" ref="model_solar_installation"/>
        <field name="domain_force">[('technician_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('solar_core.group_solar_technician'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Director / Admin: full access to installations -->
    <record id="rule_director_full_access" model="ir.rule">
        <field name="name">Director: Full Solar Installation Access</field>
        <field name="model_id" ref="model_solar_installation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('solar_core.group_solar_director'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>

