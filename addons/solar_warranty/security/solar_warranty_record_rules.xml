<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Technician: read-only own installation warranties -->
    <record id="rule_technician_own_warranties" model="ir.rule">
        <field name="name">Technician: Own Installation Warranties Only</field>
        <field name="model_id" ref="model_solar_warranty"/>
        <field name="domain_force">[('installation_id.technician_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('solar_core.group_solar_technician'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Operations Manager: full warranty access -->
    <record id="rule_operations_full_warranty" model="ir.rule">
        <field name="name">Operations Manager: Full Warranty Access</field>
        <field name="model_id" ref="model_solar_warranty"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('solar_core.group_solar_operations_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Director: full warranty access -->
    <record id="rule_director_full_warranty_access" model="ir.rule">
        <field name="name">Director: Full Warranty Access</field>
        <field name="model_id" ref="model_solar_warranty"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('solar_core.group_solar_director'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
