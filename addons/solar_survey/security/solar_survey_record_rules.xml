<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Surveyor: own surveys only -->
    <record id="rule_surveyor_own_surveys" model="ir.rule">
        <field name="name">Surveyor: Own Surveys Only</field>
        <field name="model_id" ref="model_solar_site_survey"/>
        <field name="domain_force">['|', ('surveyor_id', '=', user.id), ('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('solar_core.group_solar_surveyor'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Operations Manager: full survey access for review/approval -->
    <record id="rule_operations_full_survey_access" model="ir.rule">
        <field name="name">Operations Manager: Full Survey Access</field>
        <field name="model_id" ref="model_solar_site_survey"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('solar_core.group_solar_operations_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Director: full survey access -->
    <record id="rule_director_full_survey_access" model="ir.rule">
        <field name="name">Director: Full Survey Access</field>
        <field name="model_id" ref="model_solar_site_survey"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('solar_core.group_solar_director'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
