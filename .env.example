# --- PostgreSQL ---
POSTGRES_DB=solarflow
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_PORT=5432

# --- Odoo ---
ODOO_HTTP_PORT=8069
ODOO_LONGPOLL_PORT=8072
ODOO_ADMIN_PASSWD=CHANGE_ME_ADMIN_MASTER_PASSWORD

